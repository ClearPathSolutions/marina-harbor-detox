  "title": "San Francisco Detox Center Facility Tour",
  "h1": "Facility",
  "metaDescription": "Take a virtual tour of Marina Harbor Detox in San Francisco. Explore our residential detox, designed to support recovery from drug and alcohol addiction.",
  "canonical": "https://marinaharbordetox.com/facility/",
